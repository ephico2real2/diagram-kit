{
  "kind": "Dashboard",
  "metadata": {
    "name": "kit-kinds",
    "createdAt": "0001-01-01T00:00:00Z",
    "updatedAt": "0001-01-01T00:00:00Z",
    "version": 0,
    "project": ""
  },
  "spec": {
    "display": {
      "name": "Kinds"
    },
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "display": {
            "name": "Data source",
            "hidden": false
          },
          "allowAllValue": false,
          "allowMultiple": false,
          "plugin": {
            "kind": "DatasourceVariable",
            "spec": {
              "datasourcePluginKind": "PrometheusDatasource"
            }
          },
          "name": "DS_PROMETHEUS"
        }
      }
    ],
    "panels": {
      "0_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Pods up",
            "description": "Pods whose scrape answers."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "colorMode": "value",
              "format": {
                "unit": "decimal"
              },
              "thresholds": {
                "steps": [
                  {
                    "color": "#e15759",
                    "value": 0
                  },
                  {
                    "color": "#59a14f",
                    "value": 3
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum(up{job=\"app\"})",
                    "seriesNameFormat": ""
                  }
                }
              }
            }
          ]
        }
      },
      "0_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "How to read this page"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Each pod has **one colour** on every panel."
            }
          }
        }
      },
      "1_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requests per second, per pod",
            "description": "5 minute rate."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "querySettings": [
                {
                  "areaOpacity": 0.3,
                  "colorMode": "fixed",
                  "colorValue": "#4e79a7",
                  "queryIndex": 0
                },
                {
                  "areaOpacity": 0.3,
                  "colorMode": "fixed",
                  "colorValue": "#e15759",
                  "lineStyle": "dashed",
                  "queryIndex": 1
                }
              ],
              "visual": {
                "areaOpacity": 0,
                "lineWidth": 1,
                "stack": "all"
              },
              "yAxis": {
                "format": {
                  "unit": "requests/sec"
                },
                "min": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (pod) (rate(app_requests_total{pod=\"app-0\"}[5m]))",
                    "seriesNameFormat": "{{pod}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (pod) (rate(app_requests_total{pod=\"app-1\"}[5m]))",
                    "seriesNameFormat": "{{pod}}"
                  }
                }
              }
            }
          ]
        }
      },
      "1_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Share of requests now, by pod",
            "description": "Empty when no request ran."
          },
          "plugin": {
            "kind": "PieChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "requests/sec"
              },
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "radius": 50,
              "showLabels": true
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (pod) (rate(app_requests_total{pod=\"app-0\"}[5m]))",
                    "seriesNameFormat": "{{pod}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (pod) (rate(app_requests_total{pod=\"app-1\"}[5m]))",
                    "seriesNameFormat": "{{pod}}"
                  }
                }
              }
            }
          ]
        }
      },
      "2_0": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Each pod, now",
            "description": "One row per pod."
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "columnSettings": [
                {
                  "format": {
                    "unit": "bytes"
                  },
                  "header": "Size",
                  "name": "value #1"
                },
                {
                  "format": {
                    "unit": "decimal"
                  },
                  "header": "Items",
                  "name": "value #2"
                },
                {
                  "cellSettings": [
                    {
                      "backgroundColor": "#4e79a7",
                      "condition": {
                        "kind": "Value",
                        "spec": {
                          "value": "app-0"
                        }
                      }
                    },
                    {
                      "backgroundColor": "#edc948",
                      "condition": {
                        "kind": "Value",
                        "spec": {
                          "value": "app-1"
                        }
                      }
                    }
                  ],
                  "header": "the pod",
                  "name": "pod"
                },
                {
                  "hide": true,
                  "name": "timestamp"
                }
              ],
              "density": "compact",
              "transforms": [
                {
                  "kind": "MergeSeries",
                  "spec": {}
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (pod) (app_size_bytes)",
                    "seriesNameFormat": ""
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (pod) (app_items)",
                    "seriesNameFormat": ""
                  }
                }
              }
            }
          ]
        }
      },
      "2_1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Items not ready, per pod",
            "description": "Green while every item is ready."
          },
          "plugin": {
            "kind": "StatusHistoryChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "mappings": [
                {
                  "kind": "Value",
                  "spec": {
                    "result": {
                      "color": "#59a14f",
                      "value": "ready"
                    },
                    "value": "0"
                  }
                },
                {
                  "kind": "Range",
                  "spec": {
                    "from": 1,
                    "result": {
                      "color": "#e15759",
                      "value": "not ready"
                    },
                    "to": null
                  }
                }
              ],
              "sorting": "asc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (pod) (app_items_not_ready)",
                    "seriesNameFormat": "{{pod}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Is it up?",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 1,
              "width": 6,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/0_0"
              }
            },
            {
              "x": 6,
              "y": 1,
              "width": 18,
              "height": 4,
              "content": {
                "$ref": "#/spec/panels/0_1"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Is traffic even?",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 6,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/1_0"
              }
            },
            {
              "x": 12,
              "y": 6,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/1_1"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Does every pod hold the same?",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 15,
              "width": 24,
              "height": 5,
              "content": {
                "$ref": "#/spec/panels/2_0"
              }
            },
            {
              "x": 0,
              "y": 20,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/2_1"
              }
            }
          ]
        }
      }
    ],
    "duration": "1h"
  }
}
